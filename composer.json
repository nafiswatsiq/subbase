{
  "name": "nafiswatsiq/subbase",
  "description": "Filament plugin for advanced subscriptions",
  "type": "library",
  "license": "MIT",
  "keywords": ["filament", "subscription", "laravel", "saas", "billing", "multi-currency"],
  "homepage": "https://github.com/nafiswatsiq/subbase",
  "authors": [
    {
      "name": "Nafis Watsiq",
      "email": "nafiswatsiq@gmail.com"
    }
  ],
  "require": {
      "php": "^8.2",
      "filament/filament": "^5.0",
      "laravelcm/laravel-subscriptions": "^1.8",
      "spatie/laravel-package-tools": "^1.16"
  },
  "autoload": {
      "psr-4": {
          "Nafiswatsiq\\Subbase\\": "src/"
      }
  },
  "extra": {
      "laravel": {
          "providers": [
              "Nafiswatsiq\\Subbase\\SubbaseServiceProvider"
          ]
      }
